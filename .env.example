# Bu dosyayı .env adıyla kopyalayın ve değerleri değiştirin. .env git'e girmez.
# Parolada yalnızca harf ve rakam kullanın (bağlantı metni ';' ve '=' karakterlerini ayırıcı sayar).
POSTGRES_PASSWORD=degistirBunu
POSTGRES_PORT=55432
API_PORT=58080
# Yalnızca "docker compose --profile monitoring up -d" için. Boşsa Grafana hiç açılmaz (varsayılan parola kullanılmaz).
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=53001
