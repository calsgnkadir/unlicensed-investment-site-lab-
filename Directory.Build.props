<Project>
  <!-- Ortak ayarlar: Bütün projeler aynı çerçeveyi ve aynı derleyici kurallarını kullanır. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Paket bağımlılıkları kilit dosyasıyla sabitlenir; CI aynı sürümleri geri yükler. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Derlendiği commit, AssemblyInformationalVersion içine "+sha" olarak yazılır (SDK, .git klasöründen okur).
         Kilitli test, çalışan programın commit'ini HEAD ile karşılaştırır (E9). -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
